# AudioSleuth .gitignore
# Digital Audio Forensics Toolkit

# Python Virtual Environments & Packages
.venv/
env/
venv/
ENV/
*.py[cod]
*$py.class
__pycache__/

# Python Distribution / Build
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Quality
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Node & Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.oxlint_cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Forensic Evidence Storage & Generated Case Data
# (Original recordings and SQLite case data must remain local and untracked)
backend/data/evidence/*
!backend/data/evidence/.gitkeep
backend/data/test_evidence/*
!backend/data/test_evidence/.gitkeep
backend/data/*.db
backend/data/*.db-journal
backend/data/*.sqlite
backend/data/*.sqlite3

# Environment & Secrets
.env
.env.local
.env.*.local
backend/.env
frontend/.env

# IDE & OS Files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
