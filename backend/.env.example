# AudioSleuth Backend Configuration
ENVIRONMENT=development
DEBUG=True
APP_NAME=AudioSleuth
APP_VERSION=0.1.0
API_PREFIX=/api
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Storage & Persistence
EVIDENCE_STORAGE_DIR=./data/evidence
DATABASE_URL=sqlite:///./data/audiosleuth.db
MAX_UPLOAD_SIZE_MB=100

# Logging
LOG_LEVEL=INFO
